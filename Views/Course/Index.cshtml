@model IEnumerable<BTNetcore.Models.Course>

<a asp-action="Create" class="btn btn-primary">Thêm mới</a>

<table class="table">
    <thead>
    <tr>
        <th>Tên khóa học</th>
        <th>Tiêu đề</th>
        <th>Mô tả</th>
        <th>Nội dung chi tiết</th>
        <th>Image</th>
        <th>Price</th>
        <th>Ngày bắt đầu</th>
        <th>Ngày kết thúc</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Category.Name</td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>@Html.Raw(@item.Content)</td>
            <td><img src="@item.ImageUrl" alt=""></td>
            <td>@item.Price</td>
            <td>@item.StartDate</td>
            <td>@item.EndDate</td>
            <td>
                @if (item.Status == 1)
                {
                    <span class="text-success">Hoạt động</span>
                }
                else if (item.Status == 0)
                {
                    <span class="text-danger">Đã ngưng hoạt động</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" >Sửa</a> |
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Bạn có chắc chắn muốn Ngưng hoạt động khóa học này không?');">
                    <button type="submit" class="btn btn-link text-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>